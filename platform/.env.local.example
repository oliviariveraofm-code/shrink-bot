# Copy this file to .env.local for local development, and set the same
# values in Vercel's Project Settings -> Environment Variables for production.
# Never commit the real values -- .env* is gitignored.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Both are safe to expose to the browser (NEXT_PUBLIC_ prefix) -- the anon
# key is a public identifier, not a secret. Row Level Security policies on
# the database and storage bucket are what actually enforce access control,
# not the secrecy of this key. See supabase/migrations/0001_init.sql.
